# --- обязательное ---------------------------------------------------------
BOT_TOKEN=123456:ЗАМЕНИ_НА_ТОКЕН_ОТ_BOTFATHER
SECRET_KEY=ЗАМЕНИ_НА_СЛУЧАЙНУЮ_СТРОКУ   # install.sh подставляет сам
PUBLIC_BASE_URL=https://autoedit.ink

# Владелец: только он правит вайтлист командами /allow, /deny, /who.
# Ник без собаки или строка вида id:123456789
OWNER=

# --- где всё лежит --------------------------------------------------------
# Одна самодостаточная папка: код, venv, данные, конфиг, вайтлист.
AUTOEDIT_ROOT=/opt/autoedit
API_HOST=127.0.0.1
API_PORT=8081                 # install.sh подбирает свободный сам

# --- доступ ---------------------------------------------------------------
# Основной список — whitelist.txt рядом с этим файлом, он перечитывается
# на лету. Здесь можно добавить разовые исключения через пробел или запятую.
EXTRA_ALLOWED=

# --- требование рекламодателя --------------------------------------------
MIN_COVERAGE=0.25        # порог, который проверяет их бот
TARGET_COVERAGE=0.2535   # цель при сжатии: чуть выше порога, чтобы был запас
CROP_BLACK_BARS=1        # срезать чёрные поля до замера

# --- лимиты --------------------------------------------------------------
MAX_UPLOAD_BYTES=2147483648   # 2 ГБ, держать в согласии с client_max_body_size
MAX_INPUT_DURATION=1800       # 30 минут
LINK_TTL_HOURS=48
RETENTION_HOURS=72

# --- кодирование ---------------------------------------------------------
X264_PRESET=medium
X264_CRF=20

# --- прочее --------------------------------------------------------------
USE_X_ACCEL=1
LOG_LEVEL=INFO
