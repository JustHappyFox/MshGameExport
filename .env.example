# --- обязательное ---------------------------------------------------------
BOT_TOKEN=123456:ЗАМЕНИ_НА_ТОКЕН_ОТ_BOTFATHER
SECRET_KEY=ЗАМЕНИ_НА_СЛУЧАЙНУЮ_СТРОКУ   # openssl rand -hex 32
PUBLIC_BASE_URL=https://autoedit.ink

# --- пути ----------------------------------------------------------------
AUTOEDIT_DATA_DIR=/var/lib/autoedit
AUTOEDIT_BANNER=/opt/autoedit/assets/banner.mp4

# --- требование рекламодателя --------------------------------------------
MIN_COVERAGE=0.25        # порог, который проверяет их бот
TARGET_COVERAGE=0.2535   # цель при сквизе: чуть выше порога, чтобы был запас
CROP_BLACK_BARS=1        # срезать чёрные поля до замера

# --- доступ --------------------------------------------------------------
# Пусто = пускать всех. Иначе список telegram id через запятую.
ALLOWED_USER_IDS=

# --- лимиты --------------------------------------------------------------
MAX_UPLOAD_BYTES=2147483648   # 2 ГБ, держать в согласии с client_max_body_size
MAX_INPUT_DURATION=1800       # 30 минут
LINK_TTL_HOURS=48
RETENTION_HOURS=72

# --- кодирование ---------------------------------------------------------
X264_PRESET=medium
X264_CRF=20

# --- прочее --------------------------------------------------------------
USE_X_ACCEL=1
LOG_LEVEL=INFO
