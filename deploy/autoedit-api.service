[Unit]
Description=autoedit.ink API (Mini App backend)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=autoedit
Group=autoedit
WorkingDirectory=/opt/autoedit
EnvironmentFile=/etc/autoedit/autoedit.env
ExecStart=/opt/autoedit/venv/bin/uvicorn app.api:app --host 127.0.0.1 --port 8081 --proxy-headers --forwarded-allow-ips=127.0.0.1 --timeout-keep-alive 75
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=30

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/autoedit
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
