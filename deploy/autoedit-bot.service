[Unit]
Description=autoedit telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=__USER__
Group=__USER__
WorkingDirectory=__APP_ROOT__
EnvironmentFile=__APP_ROOT__/autoedit.env
ExecStart=__APP_ROOT__/venv/bin/python -m app.bot
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# бот правит whitelist.txt по командам /allow и /deny
ReadWritePaths=__APP_ROOT__/data __APP_ROOT__/whitelist.txt
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
